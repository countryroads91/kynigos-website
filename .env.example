# White-paper lead capture (/api/lead → Resend email).
# Set these in Vercel: Project Settings → Environment Variables. Do NOT commit real values.

# Required to email leads. Create a free key at https://resend.com (API Keys).
RESEND_API_KEY=

# Where white-paper download leads are emailed (e.g. bayan@kynigos.law).
LEAD_NOTIFY_EMAIL=

# Optional. Default is Resend's sandbox sender, which can only deliver to your own
# verified address. To send from kynigos.law, verify the domain in Resend and set:
# LEAD_FROM_EMAIL=Kynigos Law Firm <leads@kynigos.law>
LEAD_FROM_EMAIL=

# --- Every var below is OPTIONAL and env-gated: leave unset and the feature is
# --- simply off. Set it and the feature turns on. No code changes needed.

# Consultation scheduler embed on the homepage Get Started fork (Calendly for
# now; Phase 2 swaps to Clio Scheduler behind NEXT_PUBLIC_SCHEDULER_URL).
NEXT_PUBLIC_CALENDLY_URL=

# First-party lead/event store. Create a free Postgres at https://neon.tech,
# paste the connection string, then run: npm run db:migrate
DATABASE_URL=

# Cloudflare Turnstile bot protection (free): https://dash.cloudflare.com →
# Turnstile → Add site (kynigos.law). Both keys required; the widget appears
# and the server verifies (failing closed) once set.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# Upstash Redis for per-IP rate limiting (free): https://console.upstash.com →
# Create database → REST API credentials.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Signs white-paper download URLs so the lead gate cannot be bypassed.
# Generate with: openssl rand -hex 32
PAPER_TOKEN_SECRET=

# GA4 measurement id (G-XXXXXXX). Loads via Consent Mode v2 only after the
# visitor grants the analytics cookie category.
NEXT_PUBLIC_GA4_MEASUREMENT_ID=

# Set to 1 to show the research-notes newsletter signup (footer, article ends,
# white-paper gates). Requires DATABASE_URL; RESEND_AUDIENCE_ID is optional
# but recommended so confirmed subscribers land in the Resend Audience used
# for broadcasts (Resend dashboard → Audiences).
NEXT_PUBLIC_NEWSLETTER_ENABLED=
RESEND_AUDIENCE_ID=

# Guards /api/digest (weekly summary email to LEAD_NOTIFY_EMAIL, Vercel Cron
# on Mondays). Vercel sends it automatically as a bearer token once set.
# Generate with: openssl rand -hex 32
CRON_SECRET=

# Canonical public origin used in emailed links (newsletter confirmations).
# Defaults to https://www.kynigos.law—override only for local testing.
NEXT_PUBLIC_SITE_URL=

# Set to 1 to pause the whole site behind the under-construction holding page
# (src/app/construction). Every route but `/` answers 307, live API routes 404,
# the Monday digest cron short-circuits without mailing, and the sitemap trims
# to `/`. Nothing is deleted: unset this and redeploy to restore the site.
# Next inlines it at build time, so a change takes effect on the next deploy.
MAINTENANCE_MODE=
